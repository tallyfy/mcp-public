# Tallyfy MCP server — example environment.
#
# EVERY value here is OPTIONAL. The server starts with no .env at all, and the
# defaults below are what it already uses. Copy this to `.env` only when you want
# to change something.
#
# Any variable left blank falls back to the built-in default. Where a variable
# holds a credential the value is deliberately absent, because this file is
# published: never commit a real secret into it.

# --- Tallyfy API ---
TALLYFY_API_BASE_URL=https://api.tallyfy.com
TALLYFY_ENVIRONMENT=production
# Tallyfy's OAuth 2.1 authorization server. This host serves the discovery
# document at /.well-known/oauth-authorization-server and the signing keys at
# /.well-known/jwks.json. Staging is https://staging.account.tallyfy.com
TALLYFY_ISSUER=https://account.tallyfy.com

# --- OAuth / JWT (the server validates Tallyfy-issued bearer tokens) ---
#
# ⚠️ ALL THREE VALUES BELOW WERE WRONG UNTIL 2026-08-09, and because this file
# is published, they were wrong for everyone who adopted the mirror. The file's
# own preamble promises "the defaults below are what it already uses", so it
# asserted its own accuracy while contradicting server/constants.py. Measured,
# with the shipped defaults as the control:
#
#   this file's old values  -> ACCEPTED_MCP_RESOURCES = {'', 'https://mcp.tallyfy.com/'}
#   the shipped defaults    -> ACCEPTED_MCP_RESOURCES = {'mcp-host', 'https://mcp.tallyfy.com'}
#
# With ENFORCE_JWT_AUDIENCE=true on top, that accept-set REJECTED the canonical
# resource identifier this server publishes in
# /.well-known/oauth-protected-resource, REJECTED the legacy "mcp-host" value
# that every Tallyfy token in circulation actually carries, and ACCEPTED a token
# whose mcp_resource claim is the EMPTY STRING. So an adopter following this
# example got a server that refused every real token and admitted an empty one.
#
# The trailing slash was inert until tallyfy/mcp#812, which made
# MCP_RESOURCE_URL a member of the accept-set. That is worth noting on its own:
# #812 turned a cosmetic typo in an example file into a live authentication
# defect, and nothing anywhere went red. Match the values in
# server/constants.py, and re-derive rather than trusting this comment:
#
#   cd server && python3 -c "import constants; print(sorted(constants.ACCEPTED_MCP_RESOURCES))"

# Canonical RFC 8707 resource identifier. NO trailing slash — it is compared as
# an exact string against the token's mcp_resource claim.
MCP_RESOURCE_URL=https://mcp.tallyfy.com

# The legacy audience literal. Leave it at "mcp-host": blanking it does NOT fall
# back to the default, it puts the empty string into the accept-set, because
# os.getenv returns "" for a variable that is set-but-empty.
MCP_JWT_AUDIENCE=mcp-host

# Audience enforcement. The built-in default is "false" (server/constants.py,
# ENFORCE_AUDIENCE), and it is explicitly "false" in Tallyfy's own prod/staging
# (measured 2026-08-09 from the running containers). Turning it on rejects any
# token whose mcp_resource is outside the accept-set above, so set it only once
# you are certain what your clients present. Tracked in tallyfy/mcp#743.
ENFORCE_JWT_AUDIENCE=false

# RS256 verification key, PEM-encoded, e.g. "-----BEGIN PUBLIC KEY-----\n...".
# Leave BLANK unless you want to pin it: with no value the server verifies
# signatures against the key set Tallyfy publishes at
# ${TALLYFY_JWKS_BASE}/.well-known/jwks.json, which also means key rotations are
# picked up without a redeploy. Setting it removes that runtime network lookup.
# Either way every token is signature-verified. If neither source resolves, the
# server starts and rejects every token rather than serving unauthenticated.
TALLYFY_PUBLIC_KEY=

# Override the JWKS document location. Defaults to
# ${TALLYFY_JWKS_BASE}/.well-known/jwks.json, where TALLYFY_JWKS_BASE follows
# TALLYFY_ENVIRONMENT. Only needed if your issuer publishes its keys somewhere
# non-standard. Must be https.
TALLYFY_JWKS_URI=

MCP_SESSION_TIMEOUT=3600

# --- runtime ---
PORT=9000
FASTMCP_LOG_LEVEL=INFO
LOG_VERBOSITY=normal
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# --- observability (optional) ---
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
OTEL_SERVICE_NAME=tallyfy-mcp-server

# --- internal/admin endpoints (optional; leave blank for public deployments) ---
METRICS_USERNAME=
METRICS_PASSWORD=
METRICS_ALLOWED_IPS=
